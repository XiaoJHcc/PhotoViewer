<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <OutputType>WinExe</OutputType>
        <RootNamespace>PhotoViewer.Windows</RootNamespace>
        <ApplicationTitle>PhotoViewer</ApplicationTitle>
        <!-- 显示名（窗口标题末段、版本资源 ProductName、任务栏名称）用空格；
             分发包文件名与程序集名仍用 PhotoViewer-AI（由发布脚本决定）。 -->
        <ApplicationTitle Condition="'$(PhotoViewerEnableDino)' == 'true'">PhotoViewer AI</ApplicationTitle>
        <Product>$(ApplicationTitle)</Product>
        <AssemblyTitle>$(ApplicationTitle)</AssemblyTitle>
        <AssemblyName Condition="'$(WindowsReleaseAssemblyName)' != ''">$(WindowsReleaseAssemblyName)</AssemblyName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <UseWinUI>true</UseWinUI>
        <!-- App.xaml 的 XamlControlsResources 提供 Fluent 模板和主题资源。 -->
        <WindowsPackageType>None</WindowsPackageType>
        <EnableMsixTooling>true</EnableMsixTooling>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
        <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
        <DefineConstants Condition="'$(PhotoViewerEnableDino)' == 'true'">$(DefineConstants);PHOTOVIEWER_DINO</DefineConstants>
        <ApplicationIcon>..\PhotoViewer\Assets\icon.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <Target Name="RequireExplicitWindowsEdition" BeforeTargets="Restore;PrepareForBuild"
            Condition="'$(DesignTimeBuild)' != 'true'">
        <Error Condition="'$(PhotoViewerEditionExplicit)' != 'true' Or ('$(PhotoViewerEnableDino)' != 'true' And '$(PhotoViewerEnableDino)' != 'false')"
               Text="构建 PhotoViewer.Windows 必须显式指定发行版本：-p:PhotoViewerEnableDino=false（标准版）或 -p:PhotoViewerEnableDino=true（AI 版）。运行命令见 DEV.md 的 Tasks。" />
        <Error Condition="'$(RuntimeIdentifier)' != 'win-x64'" Text="Windows 仅支持 win-x64。" />
    </Target>

    <ItemGroup>
        <PackageReference Include="Microsoft.WindowsAppSDK" />
        <PackageReference Include="Microsoft.WindowsAppSDK.ML" ExcludeAssets="all" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
        <PackageReference Include="DirectNStandard" />
        <PackageReference Include="LibHeifSharp" />
        <PackageReference Include="LibHeif.Native.win-x64" />
        <PackageReference Include="WicNet" />
        <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Condition="'$(PhotoViewerEnableDino)' == 'true'" />
        <ProjectReference Include="..\PhotoViewer\PhotoViewer.csproj"
                          AdditionalProperties="PhotoViewerEnableDino=$(PhotoViewerEnableDino)" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyMetadata Include="PhotoViewerEdition" Value="$(PhotoViewerEdition)" />
        <AssemblyMetadata Include="AppBuildNumber" Value="$(AppBuildNumber)" />
    </ItemGroup>

    <ItemGroup Condition="'$(PhotoViewerEnableDino)' != 'true'">
        <Compile Remove="Native/WindowsSimilarityPanel.cs" />
    </ItemGroup>

    <ItemGroup Condition="'$(PhotoViewerEnableDino)' == 'true'">
        <EmbeddedResource Include="..\PhotoViewer\Assets\Models\dinov3_vits16.onnx"
                          LogicalName="PhotoViewer.Windows.NativeAssets.Assets.Models.dinov3_vits16.onnx"
                          Condition="Exists('..\PhotoViewer\Assets\Models\dinov3_vits16.onnx')" />
        <Content Include="..\PhotoViewer\Assets\Models\DINOv3-LICENSE.md"
                 Link="Assets/Models/DINOv3-LICENSE.md"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
                 ExcludeFromSingleFile="false" />
    </ItemGroup>

    <Target Name="RequireWindowsPublishModel" BeforeTargets="ComputeFilesToPublish"
            Condition="'$(PhotoViewerEnableDino)' == 'true'">
        <Error Condition="!Exists('..\PhotoViewer\Assets\Models\dinov3_vits16.onnx')"
               Text="AI 版发布必须包含固定 DINOv3 模型，参见 DEV.md。" />
    </Target>

    <ItemGroup>
        <Content Remove="NativeLibs\**" />
        <None Remove="NativeLibs\**" />
        <Content Include="NativeLibs\win-x64\pvhevc.dll;NativeLibs\win-x64\pvhevc.txt;NativeLibs\win-x64\pvhevc-FFmpeg-LICENSE.txt"
                 Link="%(Filename)%(Extension)" TargetPath="%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
                 ExcludeFromSingleFile="false" />
        <Content Include="..\PhotoViewer\Assets\icon.ico" Link="icon.ico"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
                 ExcludeFromSingleFile="false" />
    </ItemGroup>

    <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
        <_WindowsVCRedistFile Include="msvcp140.dll;msvcp140_1.dll;vcruntime140.dll;vcruntime140_1.dll" />
        <Content Include="@(_WindowsVCRedistFile->'$(WindowsVCRedistDirectory)\%(Identity)')"
                 Condition="'$(WindowsVCRedistDirectory)' != ''" Link="%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
                 ExcludeFromSingleFile="false" />
    </ItemGroup>

    <Target Name="ValidateWindowsVCRedist" BeforeTargets="PrepareForBuild;ComputeFilesToPublish"
            Condition="'$(PublishSingleFile)' == 'true'">
        <Error Condition="'$(RuntimeIdentifier)' != 'win-x64'" Text="Windows single-file CRT deployment requires win-x64." />
        <Error Condition="'$(WindowsVCRedistDirectory)' == ''" Text="Use publish-win-x64-singlefile.ps1 or supply WindowsVCRedistDirectory with the validated Visual Studio Release x64 CRT directory." />
        <Error Condition="!$([System.IO.Path]::IsPathRooted('$(WindowsVCRedistDirectory)'))" Text="WindowsVCRedistDirectory must be an absolute path." />
        <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(WindowsVCRedistDirectory)', '(?i)(^|[\\/])debug_nonredist([\\/]|$)'))" Text="debug_nonredist is not redistributable." />
        <Error Condition="'$(IncludeAllContentForSelfExtract)' != 'true'" Text="Windows single-file CRT deployment requires IncludeAllContentForSelfExtract=true." />
        <Error Condition="!Exists('$(WindowsVCRedistDirectory)\%(_WindowsVCRedistFile.Identity)')" Text="Missing CRT file: $(WindowsVCRedistDirectory)\%(_WindowsVCRedistFile.Identity)" />
    </Target>

    <ItemGroup>
        <Compile Include="..\PhotoViewer.Shared\**\*.cs" />
        <Using Include="PhotoViewer.Shared" />
        <Compile Include="..\PhotoViewer.Heif\**\*.cs" />
    </ItemGroup>

    <!-- 固定使用项目版本的 ORT/DirectML，避免 WinAppSDK 同名依赖混用；标准版同样排除 SDK 推理库。 -->
    <PropertyGroup>
        <WinAppSdkMsixContentDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', '$(Configuration)', '$(TargetFramework)', '$(RuntimeIdentifier)', 'MsixContent'))</WinAppSdkMsixContentDir>
    </PropertyGroup>
    <ItemGroup>
        <MicrosoftWindowsAppSDKFilesExcluded Include="$(WinAppSdkMsixContentDir)onnxruntime.dll" />
        <MicrosoftWindowsAppSDKFilesExcluded Include="$(WinAppSdkMsixContentDir)onnxruntime_providers_shared.dll" />
        <MicrosoftWindowsAppSDKFilesExcluded Include="$(WinAppSdkMsixContentDir)DirectML.dll" />
    </ItemGroup>
    <Import Project="PortableSingleFile.targets" />
</Project>
