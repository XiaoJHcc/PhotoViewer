<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <OutputType>WinExe</OutputType>
        <RootNamespace>PhotoViewer.Windows</RootNamespace>
        <!-- 产品身份唯一来源是根 Directory.Build.props：外部只给 PhotoViewerEdition，
             显示名、规范包 ID、分发名与 DINO 能力全部消费那里派生的属性。 -->
        <ApplicationTitle>$(PhotoViewerDisplayName)</ApplicationTitle>
        <Product>$(PhotoViewerDisplayName)</Product>
        <AssemblyTitle>$(PhotoViewerDisplayName)</AssemblyTitle>
        <!-- 分发名进文件名与程序集名（横线），显示名只进用户可见文本（空格）。
             开发构建保持 PhotoViewer.Windows.exe；发布脚本用 WindowsReleaseAssemblyName
             把分发名注入程序集/EXE 名，扫描器按实际产物核对。 -->
        <AssemblyName Condition="'$(WindowsReleaseAssemblyName)' != ''">$(WindowsReleaseAssemblyName)</AssemblyName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <UseWinUI>true</UseWinUI>
        <!-- App.xaml 的 XamlControlsResources 提供 Fluent 模板和主题资源。 -->
        <EnableMsixTooling>true</EnableMsixTooling>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
        <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
        <ApplicationIcon>..\PhotoViewer\Assets\icon.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <!-- DINO 只是 edition 派生能力，不再作为身份输入；Windows 平台专属身份（Application Id）在这里派生。 -->
    <PropertyGroup>
        <PhotoViewerDinoEnabled Condition="'$(PhotoViewerEdition)' == 'ai'">true</PhotoViewerDinoEnabled>
        <PhotoViewerDinoEnabled Condition="'$(PhotoViewerEdition)' != 'ai'">false</PhotoViewerDinoEnabled>
        <PhotoViewerApplicationId Condition="'$(PhotoViewerEdition)' == 'ai'">PhotoViewerAI</PhotoViewerApplicationId>
        <PhotoViewerApplicationId Condition="'$(PhotoViewerEdition)' != 'ai'">PhotoViewer</PhotoViewerApplicationId>
        <PhotoViewerPackageVersion Condition="'$(PhotoViewerPackageVersion)' == ''">$(AppVersion).0</PhotoViewerPackageVersion>
        <PhotoViewerPackagePublisher Condition="'$(PhotoViewerPackagePublisher)' == ''">CN=xiaojh.cc</PhotoViewerPackagePublisher>
        <PhotoViewerFileAssociationName Condition="'$(PhotoViewerFileAssociationName)' == ''">$(PhotoViewerProductId).image</PhotoViewerFileAssociationName>
        <DefineConstants Condition="'$(PhotoViewerDinoEnabled)' == 'true'">$(DefineConstants);PHOTOVIEWER_DINO</DefineConstants>
    </PropertyGroup>

    <!--
      主发布形态是每版一个独立的 MSIX（WindowsPackageForm=msix，由发布脚本传入）。
      便携单文件 EXE 是附加形态，仍是未打包（WindowsPackageType=None）：
      开发机直接 dotnet run/build 的默认形态保持不变。
    -->
    <PropertyGroup>
        <WindowsPackageForm Condition="'$(WindowsPackageForm)' == ''">portable</WindowsPackageForm>
        <WindowsPackageType Condition="'$(WindowsPackageForm)' == 'msix'">MSIX</WindowsPackageType>
        <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(WindowsPackageForm)' == 'msix'">
        <AppxBundle>Never</AppxBundle>
        <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
        <AppxPackageName>$(PhotoViewerDistributionName)-$(AppVersion)-win-x64</AppxPackageName>
        <WindowsMsixManifestPath>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', '$(Configuration)', '$(TargetFramework)', '$(RuntimeIdentifier)', 'msix', 'AppxManifest.source.xml'))</WindowsMsixManifestPath>
    </PropertyGroup>

    <Target Name="RequireExplicitWindowsEdition" BeforeTargets="Restore;PrepareForBuild"
            Condition="'$(DesignTimeBuild)' != 'true'">
        <Error Condition="'$(PhotoViewerEditionExplicit)' != 'true' Or ('$(PhotoViewerEdition)' != 'standard' And '$(PhotoViewerEdition)' != 'ai')"
               Text="构建 PhotoViewer.Windows 必须显式指定发行版本：-p:PhotoViewerEdition=standard（标准版）或 -p:PhotoViewerEdition=ai（AI 版）。运行命令见 DEV.md 的 Tasks。" />
        <Error Condition="'$(PhotoViewerEnableDino)' != '' And '$(PhotoViewerEnableDino)' != '$(PhotoViewerDinoEnabled)'"
               Text="PhotoViewerEnableDino 不再作为身份输入：只传 -p:PhotoViewerEdition=standard|ai，DINO 能力由 edition 派生，不能与 edition 分别指定。" />
        <Error Condition="'$(WindowsPackageForm)' != 'portable' And '$(WindowsPackageForm)' != 'msix'"
               Text="WindowsPackageForm 只能是 portable 或 msix。" />
        <Error Condition="'$(RuntimeIdentifier)' != 'win-x64'" Text="Windows 仅支持 win-x64。" />
    </Target>

    <ItemGroup>
        <PackageReference Include="Microsoft.WindowsAppSDK" />
        <PackageReference Include="Microsoft.WindowsAppSDK.ML" ExcludeAssets="all" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
        <PackageReference Include="DirectNStandard" />
        <PackageReference Include="LibHeifSharp" />
        <PackageReference Include="LibHeif.Native.win-x64" />
        <PackageReference Include="WicNet" />
        <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Condition="'$(PhotoViewerDinoEnabled)' == 'true'" />
        <ProjectReference Include="..\PhotoViewer\PhotoViewer.csproj"
                          AdditionalProperties="PhotoViewerEdition=$(PhotoViewerEdition)" />
    </ItemGroup>

    <!-- 身份元数据由扫描器从实际产物核对，不靠构建参数推断。 -->
    <ItemGroup>
        <AssemblyMetadata Include="PhotoViewerEdition" Value="$(PhotoViewerEdition)" />
        <AssemblyMetadata Include="PhotoViewerProductId" Value="$(PhotoViewerProductId)" />
        <AssemblyMetadata Include="PhotoViewerPackageId" Value="$(PhotoViewerPackageId)" />
        <AssemblyMetadata Include="PhotoViewerDisplayName" Value="$(PhotoViewerDisplayName)" />
        <AssemblyMetadata Include="PhotoViewerDistributionName" Value="$(PhotoViewerDistributionName)" />
        <AssemblyMetadata Include="AppBuildNumber" Value="$(AppBuildNumber)" />
    </ItemGroup>

    <ItemGroup Condition="'$(PhotoViewerDinoEnabled)' != 'true'">
        <Compile Remove="Native/WindowsSimilarityPanel.cs" />
    </ItemGroup>

    <ItemGroup Condition="'$(PhotoViewerDinoEnabled)' == 'true'">
        <EmbeddedResource Include="..\PhotoViewer\Assets\Models\dinov3_vits16.onnx"
                          LogicalName="PhotoViewer.Windows.NativeAssets.Assets.Models.dinov3_vits16.onnx"
                          Condition="Exists('..\PhotoViewer\Assets\Models\dinov3_vits16.onnx')" />
        <Content Include="..\PhotoViewer\Assets\Models\DINOv3-LICENSE.md"
                 Link="Assets/Models/DINOv3-LICENSE.md"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
                 ExcludeFromSingleFile="false" />
    </ItemGroup>

    <Target Name="RequireWindowsPublishModel" BeforeTargets="ComputeFilesToPublish"
            Condition="'$(PhotoViewerDinoEnabled)' == 'true'">
        <Error Condition="!Exists('..\PhotoViewer\Assets\Models\dinov3_vits16.onnx')"
               Text="AI 版发布必须包含固定 DINOv3 模型，参见 DEV.md。" />
    </Target>

    <ItemGroup>
        <Content Remove="NativeLibs\**" />
        <None Remove="NativeLibs\**" />
        <Content Include="NativeLibs\win-x64\pvhevc.dll;NativeLibs\win-x64\pvhevc.txt;NativeLibs\win-x64\pvhevc-FFmpeg-LICENSE.txt"
                 Link="%(Filename)%(Extension)" TargetPath="%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
                 ExcludeFromSingleFile="false" />
        <Content Include="..\PhotoViewer\Assets\icon.ico" Link="icon.ico"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
                 ExcludeFromSingleFile="false" />
    </ItemGroup>

    <!-- MSIX 清单从单一模板按 edition 派生身份写入中间目录；包资源（logo）只进 MSIX 载荷。 -->
    <ItemGroup Condition="'$(WindowsPackageForm)' == 'msix'">
        <AppxManifest Include="$(WindowsMsixManifestPath)" />
        <Content Include="Msix\Assets\*.png" Link="Assets\%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <Target Name="GenerateWindowsMsixManifest" Condition="'$(WindowsPackageForm)' == 'msix'"
            BeforeTargets="_ValidateWindowsPackageType;_ValidatePresenceOfAppxManifestItems;_CalculateInputsForGenerateCurrentProjectAppxManifest;_GenerateCurrentProjectAppxManifest">
        <Error Condition="!Exists('$(MSBuildProjectDirectory)\Msix\AppxManifest.template.xml')"
               Text="缺少 MSIX 清单模板：$(MSBuildProjectDirectory)\Msix\AppxManifest.template.xml" />
        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(WindowsMsixManifestPath)'))" />
        <Copy SourceFiles="$(MSBuildProjectDirectory)\Msix\AppxManifest.template.xml"
              DestinationFiles="$(WindowsMsixManifestPath)" />
        <XmlPoke XmlInputPath="$(WindowsMsixManifestPath)" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Name" Value="$(PhotoViewerPackageId)" />
        <XmlPoke XmlInputPath="$(WindowsMsixManifestPath)" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Publisher" Value="$(PhotoViewerPackagePublisher)" />
        <XmlPoke XmlInputPath="$(WindowsMsixManifestPath)" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version" Value="$(PhotoViewerPackageVersion)" />
        <XmlPoke XmlInputPath="$(WindowsMsixManifestPath)" Query="/*[local-name()='Package']/*[local-name()='Properties']/*[local-name()='DisplayName']" Value="$(PhotoViewerDisplayName)" />
        <XmlPoke XmlInputPath="$(WindowsMsixManifestPath)" Query="/*[local-name()='Package']/*[local-name()='Applications']/*[local-name()='Application']/@Id" Value="$(PhotoViewerApplicationId)" />
        <XmlPoke XmlInputPath="$(WindowsMsixManifestPath)" Query="/*[local-name()='Package']/*[local-name()='Applications']/*[local-name()='Application']/*[local-name()='VisualElements']/@DisplayName" Value="$(PhotoViewerDisplayName)" />
        <XmlPoke XmlInputPath="$(WindowsMsixManifestPath)" Query="/*[local-name()='Package']/*[local-name()='Applications']/*[local-name()='Application']/*[local-name()='VisualElements']/@Description" Value="$(PhotoViewerDisplayName)" />
        <XmlPoke XmlInputPath="$(WindowsMsixManifestPath)" Query="/*[local-name()='Package']/*[local-name()='Applications']/*[local-name()='Application']/*[local-name()='Extensions']/*[local-name()='Extension']/*[local-name()='FileTypeAssociation']/@Name" Value="$(PhotoViewerFileAssociationName)" />
        <XmlPoke XmlInputPath="$(WindowsMsixManifestPath)" Query="/*[local-name()='Package']/*[local-name()='Applications']/*[local-name()='Application']/*[local-name()='Extensions']/*[local-name()='Extension']/*[local-name()='FileTypeAssociation']/*[local-name()='DisplayName']" Value="$(PhotoViewerDisplayName)" />
    </Target>

    <ItemGroup Condition="'$(PublishSingleFile)' == 'true' Or '$(WindowsPackageForm)' == 'msix'">
        <_WindowsVCRedistFile Include="msvcp140.dll;msvcp140_1.dll;vcruntime140.dll;vcruntime140_1.dll" />
        <Content Include="@(_WindowsVCRedistFile->'$(WindowsVCRedistDirectory)\%(Identity)')"
                 Condition="'$(WindowsVCRedistDirectory)' != ''" Link="%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
                 ExcludeFromSingleFile="false" />
    </ItemGroup>

    <Target Name="ValidateWindowsVCRedist" BeforeTargets="PrepareForBuild;ComputeFilesToPublish"
            Condition="'$(PublishSingleFile)' == 'true' Or '$(WindowsPackageForm)' == 'msix'">
        <Error Condition="'$(RuntimeIdentifier)' != 'win-x64'" Text="Windows single-file CRT deployment requires win-x64." />
        <Error Condition="'$(WindowsVCRedistDirectory)' == ''" Text="Use publish-win-x64-singlefile.ps1 or supply WindowsVCRedistDirectory with the validated Visual Studio Release x64 CRT directory." />
        <Error Condition="!$([System.IO.Path]::IsPathRooted('$(WindowsVCRedistDirectory)'))" Text="WindowsVCRedistDirectory must be an absolute path." />
        <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(WindowsVCRedistDirectory)', '(?i)(^|[\\/])debug_nonredist([\\/]|$)'))" Text="debug_nonredist is not redistributable." />
        <Error Condition="'$(PublishSingleFile)' == 'true' And '$(IncludeAllContentForSelfExtract)' != 'true'" Text="Windows single-file CRT deployment requires IncludeAllContentForSelfExtract=true." />
        <Error Condition="!Exists('$(WindowsVCRedistDirectory)\%(_WindowsVCRedistFile.Identity)')" Text="Missing CRT file: $(WindowsVCRedistDirectory)\%(_WindowsVCRedistFile.Identity)" />
    </Target>

    <ItemGroup>
        <Compile Include="..\PhotoViewer.Shared\**\*.cs" />
        <Using Include="PhotoViewer.Shared" />
        <Compile Include="..\PhotoViewer.Heif\**\*.cs" />
    </ItemGroup>

    <!-- 固定使用项目版本的 ORT/DirectML，避免 WinAppSDK 同名依赖混用；标准版同样排除 SDK 推理库。 -->
    <PropertyGroup>
        <WinAppSdkMsixContentDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', '$(Configuration)', '$(TargetFramework)', '$(RuntimeIdentifier)', 'MsixContent'))</WinAppSdkMsixContentDir>
    </PropertyGroup>
    <ItemGroup>
        <MicrosoftWindowsAppSDKFilesExcluded Include="$(WinAppSdkMsixContentDir)onnxruntime.dll" />
        <MicrosoftWindowsAppSDKFilesExcluded Include="$(WinAppSdkMsixContentDir)onnxruntime_providers_shared.dll" />
        <MicrosoftWindowsAppSDKFilesExcluded Include="$(WinAppSdkMsixContentDir)DirectML.dll" />
    </ItemGroup>
    <Import Project="PortableSingleFile.targets" />
</Project>
