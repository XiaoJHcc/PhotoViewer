<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-macos</TargetFramework>
        <OutputType>Exe</OutputType>
        <ApplicationTitle>PhotoViewer</ApplicationTitle>
        <!-- 显示名（窗口标题、菜单、CFBundleName/DisplayName、.app 目录名）用空格；
             分发包文件名仍用 PhotoViewer-AI（由 publish.sh 的 PACKAGE_PRODUCT 决定）。 -->
        <ApplicationTitle Condition="'$(PhotoViewerEnableDino)' == 'true'">PhotoViewer AI</ApplicationTitle>
        <PhotoViewerEnableDino Condition="'$(PhotoViewerEnableDino)' == ''">false</PhotoViewerEnableDino>
        <DefineConstants Condition="'$(PhotoViewerEnableDino)' == 'true'">$(DefineConstants);PHOTOVIEWER_DINO</DefineConstants>
        <!-- 最低部署版本与 SwiftUI 动态库的 arm64-apple-macosx26.0 目标保持一致。 -->
        <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
        <UseAppHost>true</UseAppHost>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RuntimeIdentifiers>osx-arm64</RuntimeIdentifiers>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!--
          .NET for macOS 27.0.10722 声明需要 Xcode 27.0，_ValidateXcodeVersion 做 major.minor 精确比较，
          App Store 提供的 Xcode 27.1 会被直接判为不匹配。与 PhotoViewer.iOS 同口径关闭该精确版本校验；
          待发布支持 Xcode 27.1 的 workload 后移除本项。
        -->
        <ValidateXcodeVersion>false</ValidateXcodeVersion>
    </PropertyGroup>

    <ItemGroup Condition="'$(PhotoViewerEnableDino)' == 'true'">
        <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    </ItemGroup>

    <ItemGroup Condition="'$(PhotoViewerEnableDino)' != 'true'">
        <Compile Remove="Native/MacSimilarityPanel.cs" />
        <Compile Remove="Native/NativeSimilarityAcceptance.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PhotoViewer\PhotoViewer.csproj"
                          AdditionalProperties="PhotoViewerEnableDino=$(PhotoViewerEnableDino)" />
    </ItemGroup>

    <!--
      共享几何源：PhotoViewer.Shared/ 是纯源文件目录（不是独立程序集），
      由 Mac / iOS / Android 三个原生头共同链接；PhotoViewer.Apple/ 继续承载
      Apple 专属的展示解码、Metal 渲染与验收判定。
      这两个目录都不得出现 AppKit/UIKit 类型，平台专属部分留在各自 head 的 Native/ 下。
    -->
    <ItemGroup>
        <Compile Include="..\PhotoViewer.Apple\**\*.cs"/>
        <Compile Include="..\PhotoViewer.Shared\**\*.cs"/>
        <Using Include="PhotoViewer.Shared"/>
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <UseAppHost>true</UseAppHost>
        <SelfContained>true</SelfContained>
        <PublishReadyToRun>false</PublishReadyToRun>

        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <LinkMode>SdkOnly</LinkMode>

        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <BundleResource Include="icon.icns"/>
        <BundleResource Condition="'$(PhotoViewerEnableDino)' == 'true'" Include="../PhotoViewer/Assets/Models/*.onnx" Link="Assets/Models/%(Filename)%(Extension)" />
        <BundleResource Condition="'$(PhotoViewerEnableDino)' == 'true'" Include="../PhotoViewer/Assets/Models/DINOv3-LICENSE.md" Link="Assets/Models/DINOv3-LICENSE.md" />
    </ItemGroup>

    <Target Name="_RemoveNonMacOnnxRuntimeAssets" BeforeTargets="_CodesignAppBundle">
        <ItemGroup>
            <_NonMacOnnxRuntimeAssets Include="$(AppBundleDir.TrimEnd('/'))/Contents/MonoBundle/onnxruntime*.dll" />
            <_StandardDinoAssets Condition="'$(PhotoViewerEnableDino)' != 'true'" Include="$(AppBundleDir.TrimEnd('/'))/Contents/**/*onnx*" />
            <_StandardDinoAssets Condition="'$(PhotoViewerEnableDino)' != 'true'" Include="$(AppBundleDir.TrimEnd('/'))/Contents/**/MathNet.Numerics.dll" />
        </ItemGroup>
        <Delete Files="@(_NonMacOnnxRuntimeAssets);@(_StandardDinoAssets)" />
    </Target>

    <!--
      原生设置 UI 动态库：
      设置窗口由 SwiftUI 实现（Native/SwiftSettings/MacSettingsUI.swift），
      编译成 libMacSettingsUI.dylib 落入 .app/Contents/MonoBundle/，
      随后由 _FixDylibCodeSigning 统一完成 adhoc 代码签名。
    -->
    <Target Name="_BuildSwiftSettingsDylib"
            BeforeTargets="_CodesignAppBundle"
            Inputs="$(MSBuildProjectDirectory)/Native/SwiftSettings/MacSettingsUI.swift;$(MSBuildProjectDirectory)/Native/SwiftSettings/MacToolsUI.swift"
            Outputs="$(AppBundleDir.TrimEnd('/'))/Contents/MonoBundle/libMacSettingsUI.dylib"
            Condition="$([MSBuild]::IsOSPlatform('osx'))">
        <MakeDir Directories="$(AppBundleDir.TrimEnd('/'))/Contents/MonoBundle" />
        <Exec Command="xcrun --sdk macosx swiftc -parse-as-library -emit-library -O -target arm64-apple-macosx26.0 &quot;$(MSBuildProjectDirectory)/Native/SwiftSettings/MacSettingsUI.swift&quot; &quot;$(MSBuildProjectDirectory)/Native/SwiftSettings/MacToolsUI.swift&quot; -o &quot;$(AppBundleDir.TrimEnd('/'))/Contents/MonoBundle/libMacSettingsUI.dylib&quot;"
              IgnoreExitCode="false" />
        <Message Importance="high" Text="[SwiftSettings] 编译 SwiftUI 设置动态库 → MonoBundle/libMacSettingsUI.dylib" />
    </Target>

    <!--
      macOS 26+ Code Signing 修正：
      dotnet build 产出的 .app 中部分原生 dylib 的 adhoc 签名不完整，
      内核会因 cs_invalid_page 拒绝加载并发送 SIGKILL。
      在 _CodesignAppBundle 之后追加一轮签名：先逐个签名所有 dylib，
      再对整个 .app 签名（附带 Entitlements）。
    -->
    <Target Name="_FixDylibCodeSigning"
            AfterTargets="_CodesignAppBundle"
            Condition="$([MSBuild]::IsOSPlatform('osx'))">
        <Exec Command="find &quot;$(AppBundleDir.TrimEnd('/'))&quot; -name '*.dylib' -exec codesign --force -s - {} +"
              IgnoreExitCode="false" />
        <Exec Command="codesign --force -s - --entitlements &quot;$(MSBuildProjectDirectory)/Entitlements.plist&quot; &quot;$(AppBundleDir.TrimEnd('/'))&quot;"
              IgnoreExitCode="false" />
    </Target>

    <!--
      版本号、构建号与产品名写入 obj（随 standard/ai 隔离）内的 Info.plist 副本，
      源 Info.plist 保持仓库原样；AppManifest 指向副本供 _DetectAppManifest 消费。
      副本内容与上一轮相同则不改写，保留增量构建的安静输出。
    -->
    <Target Name="_SyncInfoPlistVersion" BeforeTargets="_DetectAppManifest">
        <PropertyGroup>
            <_SyncedInfoPlist>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'Info.plist'))</_SyncedInfoPlist>
            <_SyncedInfoPlistStaging>$(_SyncedInfoPlist).tmp</_SyncedInfoPlistStaging>
        </PropertyGroup>
        <MakeDir Directories="$(IntermediateOutputPath)" />
        <Exec Command="/bin/cp &quot;$(MSBuildProjectDirectory)/Info.plist&quot; &quot;$(_SyncedInfoPlistStaging)&quot; &amp;&amp; /usr/libexec/PlistBuddy -c 'Set :CFBundleShortVersionString $(AppVersion)' -c 'Set :CFBundleVersion $(AppBuildNumber)' -c 'Set :CFBundleDisplayName $(ApplicationTitle)' -c 'Set :CFBundleName $(ApplicationTitle)' &quot;$(_SyncedInfoPlistStaging)&quot; &amp;&amp; { /usr/bin/cmp -s &quot;$(_SyncedInfoPlistStaging)&quot; &quot;$(_SyncedInfoPlist)&quot; || /bin/cp &quot;$(_SyncedInfoPlistStaging)&quot; &quot;$(_SyncedInfoPlist)&quot;; } &amp;&amp; /bin/rm -f &quot;$(_SyncedInfoPlistStaging)&quot;" />
        <PropertyGroup>
            <AppBundleManifest>$(_SyncedInfoPlist)</AppBundleManifest>
        </PropertyGroup>
        <Message Importance="high" Text="[版本同步] $(ApplicationTitle) $(AppVersion) ($(AppBuildNumber)) → $(_SyncedInfoPlist)" />
    </Target>

    <!--
      标准版与 AI 版共用一套 bin/obj 会互相复用还原资产与中间文件，
      两版的 obj 已按 edition 隔离（见根 Directory.Build.props）。
      restore 与构建都必须显式带版本开关，否则共享工程会落到另一套输出目录。
    -->
    <Target Name="_RequireExplicitDinoEdition"
            BeforeTargets="Restore;PrepareForBuild"
            Condition="'$(DesignTimeBuild)' != 'true'">
        <Error Condition="'$(PhotoViewerEditionExplicit)' != 'true' Or ('$(PhotoViewerEnableDino)' != 'true' And '$(PhotoViewerEnableDino)' != 'false')"
               Text="构建 PhotoViewer.Mac 必须显式指定发行版本：-p:PhotoViewerEnableDino=false（标准版）或 -p:PhotoViewerEnableDino=true（AI 版）。运行命令见 DEV.md 的 Tasks 或 PhotoViewer.Mac/publish.sh。" />
    </Target>
</Project>
