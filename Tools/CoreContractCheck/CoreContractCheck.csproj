<Project Sdk="Microsoft.NET.Sdk">
  <!-- Core 契约自检：真实调用本地存储实现（StorageItemId / LocalFileRef / LocalFolderRef / 随机访问 / 原子替换 / 删除），
       全部在临时目录内进行并清理；失败逐项输出并非零退出。
       用法（仓库根）：dotnet run 指定本工程目录（见仓库 DEV 的任务约定）。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CoreContractCheck</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PhotoViewer\PhotoViewer.csproj" />
  </ItemGroup>
</Project>
