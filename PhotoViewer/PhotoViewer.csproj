<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PhotoViewerEdition Condition="'$(PhotoViewerEdition)' == ''">ai</PhotoViewerEdition>
        <DefineConstants Condition="'$(PhotoViewerEdition)' == 'ai'">$(DefineConstants);PHOTOVIEWER_DINO</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ReactiveUI" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="MetadataExtractor" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Data.Sqlite" />
        <PackageReference Include="XmpCore" />
    </ItemGroup>

    <ItemGroup Condition="'$(PhotoViewerEdition)' == 'ai'">
        <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" />
        <PackageReference Include="MathNet.Numerics" />
    </ItemGroup>

    <ItemGroup Condition="'$(PhotoViewerEdition)' == 'standard'">
        <Compile Remove="Core/AI/DinoDiagnosticPresenter.cs" />
        <Compile Remove="Core/AI/DinoFeatureCache.cs" />
        <Compile Remove="Core/AI/DinoFeatureExtractor.cs" />
        <Compile Remove="Core/AI/DinoModelResources.cs" />
        <Compile Remove="Core/AI/FolderFeatureIndexer.cs" />
        <Compile Remove="Core/AI/PatchHeatmap.cs" />
        <Compile Remove="Core/AI/SimilarityService.cs" />
        <Compile Remove="ViewModels/Main/File/SimilarityPanelViewModel.cs" />
        <Compile Remove="ViewModels/Tools/DinoDebugViewModel.cs" />
    </ItemGroup>
</Project>
