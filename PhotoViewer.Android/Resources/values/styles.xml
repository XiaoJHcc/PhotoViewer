<?xml version="1.0" encoding="utf-8" ?>
<resources>

  <!--
    原生壳主题：固定深色 Material 3，不依赖 OEM 主题派生色。
    颜色全部走自有常量（不引用 ?attr/colorPrimary / ?attr/colorSurface），
    并禁用 Material You 动态取色（代码里也不调用 DynamicColors）。
  -->
  <!-- 设置半屏 Bottom Sheet：固定深色底与顶部 24dp 圆角，不引用 OEM 主题派生属性。 -->
  <style name="Theme.PhotoViewer.BottomSheet" parent="Theme.Material3.Dark.BottomSheetDialog">
    <item name="bottomSheetStyle">@style/Widget.PhotoViewer.BottomSheet</item>
    <item name="colorPrimary">@color/native_accent</item>
    <item name="colorSecondary">@color/native_accent</item>
  </style>

  <style name="Widget.PhotoViewer.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
    <item name="android:background">@color/native_sheet_background</item>
  </style>

  <!--
    主屏玻璃按钮：Material 3 深色图标按钮，uicons 字形放在图标槽内按墨迹居中，
    状态层为按钮材质上的主文字色按 M3 状态不透明度叠加；禁用只降内容、底色与几何不变。
  -->
  <style name="Widget.PhotoViewer.GlassButton" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
    <item name="rippleColor">@color/pv_glass_state_layer</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="android:insetLeft">0dp</item>
    <item name="android:insetRight">0dp</item>
    <item name="android:minWidth">0dp</item>
    <item name="android:minHeight">0dp</item>
    <item name="android:paddingLeft">0dp</item>
    <item name="android:paddingRight">0dp</item>
    <item name="android:paddingTop">0dp</item>
    <item name="android:paddingBottom">0dp</item>
    <item name="iconPadding">0dp</item>
    <item name="iconGravity">textStart</item>
    <item name="strokeWidth">0dp</item>
    <item name="android:gravity">center</item>
    <item name="android:textAlignment">center</item>
    <item name="android:includeFontPadding">false</item>
    <item name="android:textAllCaps">false</item>
  </style>

  <style name="Theme.PhotoViewer.Native.Base" parent="Theme.Material3.Dark.NoActionBar">
    <item name="colorPrimary">@color/native_accent</item>
    <item name="colorSecondary">@color/native_accent</item>
    <item name="pvGlassButtonStyle">@style/Widget.PhotoViewer.GlassButton</item>
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowBackground">@color/native_background</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
  </style>

  <style name="Theme.PhotoViewer.Native" parent="Theme.PhotoViewer.Native.Base" />
</resources>
