<?xml version="1.0" encoding="utf-8" ?>
<resources>

  <!--
    原生壳主题：固定深色 Material 3，不依赖 OEM 主题派生色。
    颜色全部走自有常量（不引用 ?attr/colorPrimary / ?attr/colorSurface），
    并禁用 Material You 动态取色（代码里也不调用 DynamicColors）。
  -->
  <!-- 设置半屏 Bottom Sheet：固定深色底与顶部 24dp 圆角，不引用 OEM 主题派生属性。 -->
  <style name="Theme.PhotoViewer.BottomSheet" parent="Theme.Material3.Dark.BottomSheetDialog">
    <item name="bottomSheetStyle">@style/Widget.PhotoViewer.BottomSheet</item>
    <item name="colorPrimary">@color/native_accent</item>
    <item name="colorSecondary">@color/native_accent</item>
  </style>

  <style name="Widget.PhotoViewer.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
    <item name="android:background">@color/native_sheet_background</item>
  </style>

  <style name="Theme.PhotoViewer.Native" parent="Theme.Material3.Dark.NoActionBar">
    <item name="colorPrimary">@color/native_accent</item>
    <item name="colorSecondary">@color/native_accent</item>
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowBackground">@color/native_background</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
  </style>
</resources>
