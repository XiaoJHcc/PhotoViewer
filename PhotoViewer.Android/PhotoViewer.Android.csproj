<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-android</TargetFramework>
        <!-- ONNX Runtime AAR 要求 minSdk >= 24（Android 7.0）；A2-M1 起必须满足此门槛 -->
        <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <ApplicationId>cc.xiaojh.PhotoViewer</ApplicationId>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- 默认情况下，C# Dev Kit 等环境很难推断通过 dotnet workload 下载的隐藏 Android SDK，
             在此提供备用寻址，确保开箱即用（无需配环境变量） -->
        <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(LocalAppData)\Android\Sdk')">$(LocalAppData)\Android\Sdk</AndroidSdkDirectory>
        <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(HOME)/Library/Android/sdk')">$(HOME)/Library/Android/sdk</AndroidSdkDirectory>
    </PropertyGroup>

    <!-- Debug 配置：将所有 .NET 程序集内嵌进 APK -->
    <!-- 默认 Debug 启用 Fast Deployment（程序集不打包进 APK，由 IDE 单独推送），
         直接 adb install 安装时 Mono 运行时找不到程序集会立即崩溃。
         EmbedAssembliesIntoApk=true 使 Debug APK 和 Release 一样自包含，
         可直接安装运行，代价是包体积略大、构建稍慢。 -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    </PropertyGroup>

    <!-- Release 配置：启用 AOT 编译加快启动速度、减少 JIT 开销 -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <RunAOTCompilation>true</RunAOTCompilation>
        <!-- Profile-guided AOT 需要收集运行时数据，普通发布保持关闭 -->
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    </PropertyGroup>

    <ItemGroup>
        <AndroidResource Include="Icon.png">
            <Link>Resources\drawable\Icon.png</Link>
        </AndroidResource>
    </ItemGroup>

    <!--
      DINO 模型作为 AndroidAsset 打进 APK（约 +83MB）；
      原生资源提供器按 avares://PhotoViewer/Assets/Models/... 的路径部分读取 Assets/Models/...
    -->
    <ItemGroup>
        <AndroidAsset Include="..\PhotoViewer\Assets\Models\*.onnx" Link="Assets\Models\%(Filename)%(Extension)" />
        <!-- 控制栏命令图标沿用共享 uicons 字体，随 APK 打包。 -->
        <AndroidAsset Include="..\PhotoViewer\Assets\Fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.ML.OnnxRuntime" />
        <!-- 原生壳：Material 3 主题/控件、胶片栏 RecyclerView、edge-to-edge insets、设置 BottomSheet -->
        <PackageReference Include="Xamarin.Google.Android.Material" />
        <PackageReference Include="Xamarin.AndroidX.RecyclerView" />
        <PackageReference Include="Xamarin.AndroidX.Window" />
        <PackageReference Include="Xamarin.AndroidX.Fragment" />
        <!-- LibHeifSharp：libheif 软件解码器，支持 HEIF YUV 4:2:2 等系统不支持的格式 -->
        <!-- 需配套将 libheif.so + libde265.so 放入 NativeLibs/{abi}/ 目录（见下方） -->
        <PackageReference Include="LibHeifSharp"/>
    </ItemGroup>

    <!--
        libheif 原生库配置：
        运行 .\build-native-android.ps1 脚本自动交叉编译，需要 Android NDK + CMake + Ninja。

        构建策略：libde265 编译为静态库并链接进 libheif.so，只需分发 libheif.so 一个文件。
          NativeLibs/arm64-v8a/libheif.so    ← 包含 HEIF 解码 + HEVC(libde265) 解码
          NativeLibs/armeabi-v7a/libheif.so
          NativeLibs/x86_64/libheif.so

        缺少 .so 的 ABI / 系统版本（< API 28）将自动回退到系统 BitmapFactory 解码器。
        libde265.so 条目已保留（Condition 防止文件不存在时报错），可忽略。
    -->
    <ItemGroup>
        <AndroidNativeLibrary
            Condition="Exists('NativeLibs\arm64-v8a\libde265.so')"
            Include="NativeLibs\arm64-v8a\libde265.so">
            <Abi>arm64-v8a</Abi>
        </AndroidNativeLibrary>
        <AndroidNativeLibrary
            Condition="Exists('NativeLibs\arm64-v8a\libheif.so')"
            Include="NativeLibs\arm64-v8a\libheif.so">
            <Abi>arm64-v8a</Abi>
        </AndroidNativeLibrary>
        <AndroidNativeLibrary
            Condition="Exists('NativeLibs\armeabi-v7a\libde265.so')"
            Include="NativeLibs\armeabi-v7a\libde265.so">
            <Abi>armeabi-v7a</Abi>
        </AndroidNativeLibrary>
        <AndroidNativeLibrary
            Condition="Exists('NativeLibs\armeabi-v7a\libheif.so')"
            Include="NativeLibs\armeabi-v7a\libheif.so">
            <Abi>armeabi-v7a</Abi>
        </AndroidNativeLibrary>
        <AndroidNativeLibrary
            Condition="Exists('NativeLibs\x86_64\libde265.so')"
            Include="NativeLibs\x86_64\libde265.so">
            <Abi>x86_64</Abi>
        </AndroidNativeLibrary>
        <AndroidNativeLibrary
            Condition="Exists('NativeLibs\x86_64\libheif.so')"
            Include="NativeLibs\x86_64\libheif.so">
            <Abi>x86_64</Abi>
        </AndroidNativeLibrary>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PhotoViewer\PhotoViewer.csproj"/>
    </ItemGroup>

    <!--
      共享几何源：PhotoViewer.Shared/ 以 Compile Include 链接进 Android 头（不新增程序集），
      与 Mac / iOS 共用视口、主屏分区、胶片栏、控制栏、分析栏、相似面板与 EXIF 表几何。
      这些文件是纯 double 数学，不得引用 Apple/Android 平台类型。
    -->
    <ItemGroup>
        <Compile Include="..\PhotoViewer.Shared\**\*.cs"/>
        <Using Include="PhotoViewer.Shared"/>
    </ItemGroup>
<!--
  Microsoft.ML.OnnxRuntime 1.24.4 在 net10.0-android 下把 runtimes/linux-arm64/native/*.so
  误放进 FrameworkNativeLibrary。这些是 glibc 构建（依赖 libdl.so.2），会被打进
  lib/arm64-v8a 并盖掉 AAR 里的 Android bionic 版本，导致 libonnxruntime4j_jni.so
  启动即 UnsatisfiedLinkError（DINO 不可用）。这里在 APK 打包前移除 Linux 资产，
  使用 AAR 的 jni/<abi>/libonnxruntime.so。
-->
<Target Name="_PvRemoveLinuxOnnxFromApk" BeforeTargets="_BuildApkEmbed">
  <ItemGroup>
    <FrameworkNativeLibrary Remove="$(NuGetPackageRoot)microsoft.ml.onnxruntime/*/runtimes/linux-arm64/native/*.so" />
  </ItemGroup>
</Target>
</Project>
