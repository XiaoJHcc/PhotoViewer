<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only overlay: DocumentsProvider must advertise DOCUMENTS_PROVIDER, otherwise
     DocumentsContract.isDocumentUri() refuses to treat its URIs as documents. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application>
		<provider android:name="cc.xiaojh.PhotoViewer.Core.DebugTestDocumentsProvider">
			<intent-filter>
				<action android:name="android.content.action.DOCUMENTS_PROVIDER" />
			</intent-filter>
		</provider>
	</application>
</manifest>
