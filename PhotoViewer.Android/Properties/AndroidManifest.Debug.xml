<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only overlay: DocumentsProvider must advertise DOCUMENTS_PROVIDER, otherwise
     DocumentsContract.isDocumentUri() refuses to treat its URIs as documents.
     authority 不写在这里：它由 C# [ContentProvider] 的 ${pvPackageId} 占位生成，
     随实际 ApplicationId 变化，标准版与 AI 版可同机并存。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application>
		<provider android:name="cc.xiaojh.PhotoViewer.Core.DebugTestDocumentsProvider">
			<intent-filter>
				<action android:name="android.content.action.DOCUMENTS_PROVIDER" />
			</intent-filter>
		</provider>
	</application>
</manifest>
