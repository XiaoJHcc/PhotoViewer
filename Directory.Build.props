<Project TreatAsLocalProperty="PhotoViewerEnableDino">
  <PropertyGroup>
    <!-- 统一版本号：修改此处即可同步所有平台项目 -->
    <AppVersion>0.9.3</AppVersion>
    <AppBuildNumber>93</AppBuildNumber>

    <!-- .NET 程序集版本 -->
    <Version>$(AppVersion)</Version>
    <AssemblyVersion>$(AppVersion).0</AssemblyVersion>
    <FileVersion>$(AppVersion).0</FileVersion>
    <InformationalVersion>$(AppVersion)</InformationalVersion>

    <!-- 平台 SDK 版本号（Android / iOS / macOS 通用） -->
    <!-- Android: → android:versionName / android:versionCode -->
    <!-- iOS/macOS: → CFBundleShortVersionString / CFBundleVersion -->
    <ApplicationDisplayVersion>$(AppVersion)</ApplicationDisplayVersion>
    <ApplicationVersion>$(AppBuildNumber)</ApplicationVersion>

    <!-- 产品信息 -->
    <Product>PhotoViewer</Product>
    <Company>xiaojh.cc</Company>
    <Copyright>Copyright © 2024-2026 xiaojh.cc</Copyright>
  </PropertyGroup>

  <!-- 产品身份唯一来源；平台工程只消费以下映射。 -->
  <PropertyGroup Condition="'$(PhotoViewerEdition)' == 'standard' Or '$(PhotoViewerEdition)' == 'ai'">
    <PhotoViewerProductId>photoviewer.$(PhotoViewerEdition)</PhotoViewerProductId>
    <PhotoViewerPackageId Condition="'$(PhotoViewerEdition)' == 'standard'">cc.xiaojh.PhotoViewer</PhotoViewerPackageId>
    <PhotoViewerPackageId Condition="'$(PhotoViewerEdition)' == 'ai'">cc.xiaojh.PhotoViewer.AI</PhotoViewerPackageId>
    <PhotoViewerDisplayName Condition="'$(PhotoViewerEdition)' == 'standard'">PhotoViewer</PhotoViewerDisplayName>
    <PhotoViewerDisplayName Condition="'$(PhotoViewerEdition)' == 'ai'">PhotoViewer AI</PhotoViewerDisplayName>
    <PhotoViewerDistributionName Condition="'$(PhotoViewerEdition)' == 'standard'">PhotoViewer</PhotoViewerDistributionName>
    <PhotoViewerDistributionName Condition="'$(PhotoViewerEdition)' == 'ai'">PhotoViewer-AI</PhotoViewerDistributionName>
    <PhotoViewerEnableDino Condition="'$(PhotoViewerEdition)' == 'standard'">false</PhotoViewerEnableDino>
    <PhotoViewerEnableDino Condition="'$(PhotoViewerEdition)' == 'ai'">true</PhotoViewerEnableDino>
  </PropertyGroup>

  <!-- 必须早于 Microsoft.Common.props 隔离两版还原资产；头工程通过 ProjectReference 透传 edition。 -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'PhotoViewer.Mac' Or '$(MSBuildProjectName)' == 'PhotoViewer.iOS' Or '$(MSBuildProjectName)' == 'PhotoViewer.Android' Or '$(MSBuildProjectName)' == 'PhotoViewer.Windows'">
    <PhotoViewerEditionExplicit Condition="'$(PhotoViewerEdition)' != ''">true</PhotoViewerEditionExplicit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'PhotoViewer.Mac' Or '$(MSBuildProjectName)' == 'PhotoViewer.iOS' Or '$(MSBuildProjectName)' == 'PhotoViewer.Android' Or '$(MSBuildProjectName)' == 'PhotoViewer.Windows' Or '$(MSBuildProjectName)' == 'PhotoViewer'">
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="('$(PhotoViewerEdition)' == 'standard' Or '$(PhotoViewerEdition)' == 'ai') And ('$(MSBuildProjectName)' == 'PhotoViewer.Mac' Or '$(MSBuildProjectName)' == 'PhotoViewer.iOS' Or '$(MSBuildProjectName)' == 'PhotoViewer.Android' Or '$(MSBuildProjectName)' == 'PhotoViewer.Windows' Or '$(MSBuildProjectName)' == 'PhotoViewer')">
    <BaseOutputPath Condition="'$(BaseOutputPath)' == ''">bin/$(PhotoViewerEdition)/</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == ''">obj/$(PhotoViewerEdition)/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
