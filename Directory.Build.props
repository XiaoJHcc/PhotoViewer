<Project>
  <PropertyGroup>
    <!-- 统一版本号：修改此处即可同步所有平台项目 -->
    <AppVersion>0.9.0</AppVersion>
    <AppBuildNumber>90</AppBuildNumber>

    <!-- .NET 程序集版本 -->
    <Version>$(AppVersion)</Version>
    <AssemblyVersion>$(AppVersion).0</AssemblyVersion>
    <FileVersion>$(AppVersion).0</FileVersion>
    <InformationalVersion>$(AppVersion)</InformationalVersion>

    <!-- 平台 SDK 版本号（Android / iOS / macOS 通用） -->
    <!-- Android: → android:versionName / android:versionCode -->
    <!-- iOS/macOS: → CFBundleShortVersionString / CFBundleVersion -->
    <ApplicationDisplayVersion>$(AppVersion)</ApplicationDisplayVersion>
    <ApplicationVersion>$(AppBuildNumber)</ApplicationVersion>

    <!-- 产品信息 -->
    <Product>PhotoViewer</Product>
    <Company>xiaojh.cc</Company>
    <Copyright>Copyright © 2024-2026 xiaojh.cc</Copyright>
  </PropertyGroup>

  <!--
    Mac 双版本构建隔离：PhotoViewer.Mac 与它引用的共享工程按 standard/ai 分开 bin/obj，
    两版不再共用还原资产与中间文件。必须在 Microsoft.Common.props 写入默认 obj 之前求值，
    所以放在这里；构建入口（VS Code Tasks / publish.sh）显式传 PhotoViewerEnableDino，
    该属性随 ProjectReference 传入共享工程。其他平台工程不带该属性，输出路径保持原样。
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'PhotoViewer.Mac'">
    <PhotoViewerEditionExplicit Condition="'$(PhotoViewerEnableDino)' != ''">true</PhotoViewerEditionExplicit>
    <PhotoViewerEnableDino Condition="'$(PhotoViewerEnableDino)' == ''">false</PhotoViewerEnableDino>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'PhotoViewer.Mac' Or '$(MSBuildProjectName)' == 'PhotoViewer'">
    <!-- 默认通配只排除当前 bin/obj；Mac 的 edition 子目录与历史目录都要排除，避免生成代码串进编译。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PhotoViewerEnableDino)' != '' And ('$(MSBuildProjectName)' == 'PhotoViewer.Mac' Or '$(MSBuildProjectName)' == 'PhotoViewer')">
    <PhotoViewerEdition Condition="'$(PhotoViewerEnableDino)' == 'true'">ai</PhotoViewerEdition>
    <PhotoViewerEdition Condition="'$(PhotoViewerEnableDino)' != 'true'">standard</PhotoViewerEdition>
    <BaseOutputPath Condition="'$(BaseOutputPath)' == ''">bin/$(PhotoViewerEdition)/</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == ''">obj/$(PhotoViewerEdition)/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
